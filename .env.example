# Copy these into the Vercel project's Environment Variables (and .env.local for local dev).

# Supabase: use the SAME project as tetra-household if you like. This app only touches dl_* tables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Admin console (/admin) password and an optional separate token-signing secret.
ADMIN_PASSWORD=<choose a strong passcode>
# ADMIN_SESSION_SECRET=<random string>

# Secret used by the keepalive cron (Vercel cron + GitHub Actions send it as a Bearer token).
CRON_SECRET=<random string>

# Gmail inboxes that receive the Netflix emails. One pair per inbox (use the real inbox address,
# without +tags). A Netflix ID like name+4@gmail.com or na.me@gmail.com is matched to the inbox
# name@gmail.com automatically. Use a Google "App password", not the account password.
GMAIL_USER_1=first-inbox@gmail.com
GMAIL_APP_PASSWORD_1=xxxx xxxx xxxx xxxx
GMAIL_USER_2=second-inbox@gmail.com
GMAIL_APP_PASSWORD_2=xxxx xxxx xxxx xxxx
# ...add GMAIL_USER_3 / GMAIL_APP_PASSWORD_3 and so on for every inbox
