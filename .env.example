# Copy these into the Vercel project's Environment Variables (and .env.local for local dev).

# Supabase: use the SAME project as tetra-household if you like. This app only touches dl_* tables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Admin console (/admin) password and an optional separate token-signing secret.
ADMIN_PASSWORD=<choose a strong passcode>
# ADMIN_SESSION_SECRET=<random string>

# Secret used by the keepalive cron (Vercel cron + GitHub Actions send it as a Bearer token).
CRON_SECRET=<random string>

# Optional: encrypts the Gmail app passwords and PayPur keys saved from the admin panel.
# Any long random string (e.g. `openssl rand -hex 32`). Keep it: if it is lost or changed, the
# saved passwords have to be entered again in the panel.
# SETTINGS_ENCRYPTION_KEY=

# Everything else (Gmail inboxes and app passwords, PayPur keys, company name, support WhatsApp,
# plans and prices, site URL, ...) is saved from the admin panel (/admin > Settings).
# The old GMAIL_USER_n / GMAIL_APP_PASSWORD_n variables still work as a fallback; in the panel,
# Settings > Gmail Inboxes can copy them over so you can delete them from Vercel.
